AIRQUIMIDES_BOT_TOKEN=your_airquimides_token_here
SESHAIT_BOT_TOKEN=your_seshait_token_here
VULKAIN_BOT_TOKEN=your_vulkain_token_here

# ============================================
# GOOGLE GEMINI API (for Antigravity agents)
# ============================================
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ============================================
# NOTION API (for MCP integration)
# ============================================
NOTION_API_KEY=secret_your_notion_integration_key
NOTION_DATABASE_HUGAIN=your_hugain_database_id
NOTION_DATABASE_MANAI=your_manai_database_id
NOTION_DATABASE_ODYSSAI=your_odyssai_database_id
NOTION_DATABASE_WUWAI=your_wuwai_database_id

# ============================================
# SECURITY (from your telegram_auth.py)
# ============================================
# Generate PIN hash: python -c "import hashlib; print(hashlib.sha256('YOUR_PIN'.encode()).hexdigest())"
MASTER_PIN_HASH=your_sha256_hashed_pin_here
SESSION_TIMEOUT=7200  # 2 hours in seconds
MAX_FAILED_ATTEMPTS=3

# ============================================
# OPERATIONAL SETTINGS
# ============================================
ENVIRONMENT=development  # or 'production'
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
TIMEZONE=America/New_York  # Your timezone

# ============================================
# WEBHOOK MODE (optional - for production)
# ============================================
USE_WEBHOOK=false
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PORT=8443
